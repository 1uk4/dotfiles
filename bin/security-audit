#!/usr/bin/env bash

# security-audit — Quick security check for OpenClaw machines
# Run anytime: security-audit
# Add to cron for periodic checks

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✓${NC} $1"; }
warn() { echo -e "  ${YELLOW}⚠${NC} $1"; }
fail() { echo -e "  ${RED}✗${NC} $1"; }

echo ""
echo "══════════════════════════════════════"
echo "  Security Audit — $(date '+%Y-%m-%d %H:%M')"
echo "══════════════════════════════════════"

# ── Failed SSH logins ──
echo ""
echo "▸ Failed SSH logins (last 24h):"
FAILED=$(journalctl -u ssh --since "24 hours ago" 2>/dev/null | grep -c "Failed password" || \
         grep -c "Failed password" /var/log/auth.log 2>/dev/null || echo "0")
if [ "$FAILED" -gt 0 ]; then
  warn "$FAILED failed login attempts"
  # Show last 5
  journalctl -u ssh --since "24 hours ago" 2>/dev/null | grep "Failed password" | tail -5 || \
    grep "Failed password" /var/log/auth.log 2>/dev/null | tail -5
else
  ok "No failed logins"
fi

# ── Fail2ban status ──
echo ""
echo "▸ Fail2ban:"
if command -v fail2ban-client &>/dev/null; then
  BANNED=$(fail2ban-client status sshd 2>/dev/null | grep "Currently banned" | awk '{print $NF}')
  if [ "${BANNED:-0}" -gt 0 ]; then
    warn "$BANNED IPs currently banned"
    fail2ban-client status sshd 2>/dev/null | grep "Banned IP"
  else
    ok "No banned IPs"
  fi
else
  fail "fail2ban not installed"
fi

# ── UFW Firewall ──
echo ""
echo "▸ Firewall (UFW):"
if command -v ufw &>/dev/null; then
  UFW_STATUS=$(ufw status | head -1)
  if echo "$UFW_STATUS" | grep -q "active"; then
    ok "UFW is active"
  else
    fail "UFW is INACTIVE"
  fi
else
  fail "UFW not installed"
fi

# ── Listening ports ──
echo ""
echo "▸ Listening ports:"
ss -tlnp 2>/dev/null | grep LISTEN | while read -r line; do
  PORT=$(echo "$line" | awk '{print $4}' | rev | cut -d: -f1 | rev)
  PROC=$(echo "$line" | grep -oP 'users:\(\("\K[^"]+' || echo "unknown")
  case "$PORT" in
    22)   ok "Port $PORT — SSH ($PROC)" ;;
    *)    warn "Port $PORT — $PROC (review if needed)" ;;
  esac
done

# ── Users with login shells ──
echo ""
echo "▸ Users with login shells:"
LOGIN_USERS=$(grep -E '/bin/(bash|zsh|sh|fish)$' /etc/passwd | cut -d: -f1)
for user in $LOGIN_USERS; do
  if [ "$user" = "root" ]; then
    warn "root has login shell (consider disabling remote root login)"
  elif [ "$user" = "hal" ]; then
    ok "$user (openclaw service user)"
  else
    warn "$user — review if needed"
  fi
done

# ── OpenClaw process ──
echo ""
echo "▸ OpenClaw:"
if pgrep -f "openclaw" &>/dev/null; then
  OCUSER=$(ps -o user= -C "openclaw" 2>/dev/null | head -1 || echo "unknown")
  if [ "$OCUSER" = "hal" ]; then
    ok "Running as user 'hal'"
  elif [ "$OCUSER" = "root" ]; then
    fail "Running as ROOT — should be 'hal'"
  else
    ok "Running as '$OCUSER'"
  fi
else
  warn "OpenClaw not running"
fi

# ── Disk usage ──
echo ""
echo "▸ Disk usage:"
DISK_PCT=$(df / | tail -1 | awk '{print $5}' | tr -d '%')
if [ "$DISK_PCT" -gt 90 ]; then
  fail "Disk ${DISK_PCT}% full"
elif [ "$DISK_PCT" -gt 75 ]; then
  warn "Disk ${DISK_PCT}% full"
else
  ok "Disk ${DISK_PCT}% used"
fi

# ── Memory ──
echo ""
echo "▸ Memory:"
if command -v free &>/dev/null; then
  MEM_PCT=$(free | awk '/Mem:/{printf "%.0f", $3/$2*100}')
  if [ "$MEM_PCT" -gt 90 ]; then
    fail "Memory ${MEM_PCT}% used"
  elif [ "$MEM_PCT" -gt 75 ]; then
    warn "Memory ${MEM_PCT}% used"
  else
    ok "Memory ${MEM_PCT}% used"
  fi
fi

# ── Uptime ──
echo ""
echo "▸ Uptime: $(uptime -p 2>/dev/null || uptime)"

echo ""
echo "══════════════════════════════════════"
echo "  Audit complete."
echo "══════════════════════════════════════"
echo ""
