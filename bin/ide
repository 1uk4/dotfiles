#!/usr/bin/env bash

# IDE Script - Opens diffview on top (full width), opencode on bottom (1/3 height)
# Usage: ide [--size=33]

set -e

SPLIT_SIZE=33

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --size=*)
            SPLIT_SIZE="${1#*=}"
            shift
            ;;
        --help|-h)
            echo "Usage: ide [--size=N]"
            echo "  --size=N    Set bottom pane height percentage for opencode (default: 33%)"
            exit 0
            ;;
        *)
            shift
            ;;
    esac
done

# Check if we're in a tmux session
if [ -z "$TMUX" ]; then
    echo "Error: This script requires tmux. Please run from within a tmux session."
    exit 1
fi

# Check if opencode is available
if ! command -v opencode &> /dev/null; then
    echo "Error: opencode command not found. Please install opencode first."
    exit 1
fi

CURRENT_DIR=$(pwd)

# Top pane (full width): diffview
ORIGINAL_PANE=$(tmux display-message -p '#{pane_id}')
tmux send-keys "nvim -c 'lua require(\"1uk4.ide-watcher\")' -c 'DiffviewOpen'" Enter
tmux select-pane -t "$ORIGINAL_PANE" -T "diffview"

# Bottom pane (1/3 height): opencode
tmux split-window -v -p "$SPLIT_SIZE" -c "$CURRENT_DIR"
OPENCODE_PANE=$(tmux display-message -p '#{pane_id}')
tmux send-keys -t "$OPENCODE_PANE" "opencode" Enter
tmux select-pane -t "$OPENCODE_PANE" -T "opencode"

# Background watcher: polls git state every 2s and refreshes diffview
# via tmux send-keys when something changes (commits, staging, file edits).
(
    sleep 4  # let nvim + diffview fully start
    last_state=""
    while tmux has-session 2>/dev/null && tmux list-panes -F '#{pane_id}' 2>/dev/null | grep -q "$ORIGINAL_PANE"; do
        state="$(git -C "$CURRENT_DIR" rev-parse HEAD 2>/dev/null)$(git -C "$CURRENT_DIR" status --porcelain 2>/dev/null)"
        if [ -n "$last_state" ] && [ "$state" != "$last_state" ]; then
            tmux send-keys -t "$ORIGINAL_PANE" Escape
            tmux send-keys -t "$ORIGINAL_PANE" ":DiffviewClose" Enter
            sleep 0.3
            tmux send-keys -t "$ORIGINAL_PANE" ":DiffviewOpen" Enter
        fi
        last_state="$state"
        sleep 2
    done
) &
WATCHER_PID=$!
disown $WATCHER_PID

# Focus back to diffview
tmux select-pane -t "$ORIGINAL_PANE"

echo "IDE setup complete: diffview (top) | opencode (bottom)"
