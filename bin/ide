#!/usr/bin/env bash

# IDE Script - Opens diffview on top (full width), opencode on bottom (1/3 height)
# Usage: ide [--size=33]

set -e

SPLIT_SIZE=33

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --size=*)
            SPLIT_SIZE="${1#*=}"
            shift
            ;;
        --help|-h)
            echo "Usage: ide [--size=N]"
            echo "  --size=N    Set bottom pane height percentage for opencode (default: 33%)"
            exit 0
            ;;
        *)
            shift
            ;;
    esac
done

# Check if we're in a tmux session
if [ -z "$TMUX" ]; then
    echo "Error: This script requires tmux. Please run from within a tmux session."
    exit 1
fi

# Check if opencode is available
if ! command -v opencode &> /dev/null; then
    echo "Error: opencode command not found. Please install opencode first."
    exit 1
fi

CURRENT_DIR=$(pwd)

# Top pane (full width): diffview
ORIGINAL_PANE=$(tmux display-message -p '#{pane_index}')
tmux send-keys "nvim -c 'set autoread' -c 'autocmd FocusGained,BufEnter * checktime' -c 'DiffviewOpen'" Enter
tmux select-pane -t "$ORIGINAL_PANE" -T "diffview"

# Bottom pane (1/3 height): opencode
tmux split-window -v -p "$SPLIT_SIZE" -c "$CURRENT_DIR"
OPENCODE_PANE=$(tmux display-message -p '#{pane_index}')
tmux send-keys -t "$OPENCODE_PANE" "opencode" Enter
tmux select-pane -t "$OPENCODE_PANE" -T "opencode"

# Focus back to diffview
tmux select-pane -t "$ORIGINAL_PANE"

echo "IDE setup complete: diffview (top) | opencode (bottom)"
