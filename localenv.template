# Local environment variables
# Copy this file to ~/.localenv and add your sensitive environment variables
# This file should NOT be tracked in your dotfiles repository

# Avante.nvim API key
export AVANTE_API_KEY="your-api-key-here"

# OpenCode / Oh-My-OpenCode API Keys
# Get your keys from:
# - Anthropic: https://console.anthropic.com/settings/keys
# - OpenAI: https://platform.openai.com/api-keys
# - Google: https://aistudio.google.com/apikey
export ANTHROPIC_API_KEY="sk-ant-YOUR_KEY_HERE"
export OPENAI_API_KEY="sk-proj-YOUR_KEY_HERE"
export GOOGLE_GENERATIVE_AI_API_KEY="AIzaYOUR_KEY_HERE"

