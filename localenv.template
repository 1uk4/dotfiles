# Local environment variables
# Copy this file to ~/.localenv and add your sensitive environment variables
# This file should NOT be tracked in your dotfiles repository

# Avante.nvim API key
export AVANTE_API_KEY="your-api-key-here"

# OpenCode / Oh-My-OpenCode API Keys
# Get your keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Google: https://aistudio.google.com/apikey
#
# NOTE: Anthropic uses Max subscription via opencode-anthropic-auth plugin.
# No ANTHROPIC_API_KEY needed — authenticate with `/connect` in OpenCode TUI.
export OPENAI_API_KEY="sk-proj-YOUR_KEY_HERE"
export GOOGLE_GENERATIVE_AI_API_KEY="AIzaYOUR_KEY_HERE"

# Add other sensitive environment variables below
# export GITHUB_TOKEN="your-github-token"
# export AWS_ACCESS_KEY_ID="your-aws-access-key"
# export AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

