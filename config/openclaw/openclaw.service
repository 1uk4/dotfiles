# OpenClaw Gateway systemd user service
# NOTE: OpenClaw auto-generates this at ~/.config/systemd/user/openclaw-gateway.service
# This is a reference template — don't symlink directly (contains no secrets).
# 
# Override file for IPv4 fix:
#   ~/.config/systemd/user/openclaw-gateway.service.d/ipv4.conf
#   [Service]
#   Environment=NODE_OPTIONS="--dns-result-order=ipv4first"
#
# Restart script for hal-admin:
#   ~/scripts/restart-hal.sh

[Unit]
Description=OpenClaw Gateway
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/bin/sleep 10
ExecStart="/usr/bin/node" "/usr/lib/node_modules/openclaw/dist/index.js" gateway --port 18789
Restart=always
RestartSec=5
KillMode=process
Environment=HOME=/home/hal

[Install]
WantedBy=default.target
