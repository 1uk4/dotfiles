{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-opus-4-6",
      "prompt_append": "IMPORTANT: Do NOT run 'npm run build' command. The build process is handled separately."
    },
    "librarian": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "explore": {
      "model": "google/gemini-2.0-flash",
      "options": {
        "thinking": true
      }
    },
    "oracle": {
      "model": "openai/gpt-5.2"
    },
    "hephaestus": {
      "model": "openai/o3"
    },
    "frontend-ui-ux-engineer": {
      "model": "google/gemini-2.5-pro",
      "options": {
        "thinking": true
      }
    },
    "document-writer": {
      "model": "google/gemini-2.0-flash",
      "options": {
        "thinking": true
      }
    },
    "multimodal-looker": {
      "model": "google/gemini-2.0-flash",
      "options": {
        "thinking": true
      }
    },
    "prometheus": {
      "model": "anthropic/claude-opus-4-6"
    }
  },
  "background_task": {
    "defaultConcurrency": 5,
    "providerConcurrency": {
      "anthropic": 3,
      "google": 10,
      "openai": 3
    },
    "modelConcurrency": {
      "openai/gpt-5.2": 2,
      "anthropic/claude-opus-4-6": 2
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "quick": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "ultrabrain": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "unspecified-low": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "unspecified-high": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "artistry": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "writing": {
      "model": "anthropic/claude-sonnet-4-6"
    }
  },
  "_migrations": [
    "model-version:anthropic/claude-sonnet-4-5->anthropic/claude-sonnet-4-6",
    "model-version:anthropic/claude-sonnet-4-5->anthropic/claude-sonnet-4-6",
    "model-version:anthropic/claude-sonnet-4-5->anthropic/claude-sonnet-4-6",
    "model-version:anthropic/claude-sonnet-4-5->anthropic/claude-sonnet-4-6",
    "model-version:anthropic/claude-sonnet-4-5->anthropic/claude-sonnet-4-6",
    "model-version:anthropic/claude-sonnet-4-5->anthropic/claude-sonnet-4-6",
    "model-version:anthropic/claude-sonnet-4-5->anthropic/claude-sonnet-4-6",
    "model-version:anthropic/claude-sonnet-4-5->anthropic/claude-sonnet-4-6"
  ]
}
