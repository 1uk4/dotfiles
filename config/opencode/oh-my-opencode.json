{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-sonnet-4-5"
    },
    "librarian": {
      "model": "anthropic/claude-sonnet-4-5"
    },
    "explore": {
      "model": "google/gemini-2.0-flash",
      "options": {
        "thinking": false
      }
    },
    "oracle": {
      "model": "openai/gpt-5.2"
    },
    "frontend-ui-ux-engineer": {
      "model": "google/gemini-2.5-pro",
      "options": {
        "thinking": true
      }
    },
    "document-writer": {
      "model": "google/gemini-2.0-flash",
      "options": {
        "thinking": false
      }
    },
    "multimodal-looker": {
      "model": "google/gemini-2.0-flash",
      "options": {
        "thinking": false
      }
    },
    "prometheus": {
      "model": "anthropic/claude-sonnet-4-5"
    }
  },
  "background_task": {
    "defaultConcurrency": 5,
    "providerConcurrency": {
      "anthropic": 3,
      "google": 10,
      "openai": 3
    },
    "modelConcurrency": {
      "openai/gpt-5.2": 2,
      "anthropic/claude-opus-4-5": 2
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "google/gemini-2.5-pro",
      "options": {
        "thinking": true
      }
    },
    "quick": {
      "model": "google/gemini-2.0-flash",
      "options": {
        "thinking": false
      }
    },
    "ultrabrain": {
      "model": "anthropic/claude-opus-4-5",
      "options": {
        "thinking": true
      }
    },
    "unspecified-low": {
      "model": "anthropic/claude-sonnet-4-5"
    },
    "unspecified-high": {
      "model": "anthropic/claude-opus-4-5",
      "options": {
        "thinking": true
      }
    },
    "artistry": {
      "model": "google/gemini-2.5-pro",
      "options": {
        "thinking": true
      }
    },
    "writing": {
      "model": "google/gemini-2.0-flash",
      "options": {
        "thinking": false
      }
    }
  }
}
